{
  "name": "ispm-erp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:frontend": "tsc -b && vite build",
    "build:backend": "cd server && npm run build",
    "build:all": "npm run build:frontend && npm run copy:frontend && npm run build:backend",
    "copy:frontend": "node scripts/copy-frontend.mjs",
