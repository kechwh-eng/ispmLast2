# === PEDAGO ERP — variables d'environnement =================================
# En hebergement Hostinger (Node.js Web App), ces variables se definissent
# dans hPanel > Node.js web app > Environment variables (pas de fichier .env).

# --- Serveur (server/) ------------------------------------------------------

# Base SQLite. Sur Hostinger, LAISSER VIDE : app.cjs la place automatiquement
# dans DATA_DIR (voir ci-dessous), hors du dossier applicatif.
# En local/dev uniquement : DATABASE_URL="file:./dev.db"
# DATABASE_URL=

# Dossier de donnees persistantes (base + documents televerses).
# DOIT etre HORS du dossier de l'application (survit aux deploiements).
# Defaut si absent : <home utilisateur>/pedago-data
DATA_DIR=

# Secret de signature des sessions — OBLIGATOIRE en production.
# Generer une valeur aleatoire longue (64+ caracteres), ex. :
#   openssl rand -base64 48
JWT_SECRET=

# Port d'ecoute. Sur Hostinger : NE PAS DEFINIR (fourni par la plateforme).
# PORT=3001

# Compte administrateur cree automatiquement si la base est vierge.
ADMIN_EMAIL=admin@pedago.ma
ADMIN_PASSWORD=admin123
ETABLISSEMENT=PEDAGO

# NODE_ENV=production  (facultatif : le mode production s'active
# automatiquement quand server/public/index.html existe)

# --- Frontend (build Vite) --------------------------------------------------
# URL de l'API. En production frontend et API partagent le meme domaine :
# ne rien definir (valeur par defaut relative /api).
# En local/dev uniquement :
# VITE_API_URL=http://localhost:3001/api
